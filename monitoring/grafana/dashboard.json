{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Total Request Rate (RPS)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(econocausal_http_requests_total[1m]))",
          "legendFormat": "req/sec",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "p95 Latency",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(econocausal_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 (s)",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Error Rate (5xx %)",
      "type": "stat",
      "targets": [
        {
          "expr": "(sum(rate(econocausal_http_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(econocausal_http_requests_total[5m]))) * 100",
          "legendFormat": "5xx %",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Active WebSockets",
      "type": "stat",
      "targets": [
        {
          "expr": "econocausal_active_websocket_connections",
          "legendFormat": "connections",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "title": "HTTP Request Throughput by Endpoint",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (endpoint) (rate(econocausal_http_requests_total[1m]))",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "title": "Request Duration Heatmap",
      "type": "heatmap",
      "targets": [
        {
          "expr": "sum(rate(econocausal_http_request_duration_seconds_bucket[5m])) by (le)",
          "format": "heatmap",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
