# ==============================================================================
# EconoCausal Platform — Environment Configuration Template
# ==============================================================================

# Server & Network Configuration
PORT=8000
HOST=0.0.0.0
WORKERS=2
LOG_LEVEL=info
ENVIRONMENT=production
DEBUG=false

# Security & Authentication
SECRET_KEY=econocausal_super_secure_secret_key_change_in_production_2026!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
API_KEY_HEADER=X-API-Key
MASTER_API_KEY=ec_live_k8s_cluster_key_007a
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,econocausal.internal

# CORS (comma-separated allowed origins or * for all in dev)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://econocausal.internal

# Rate Limiting & DoS Protection
RATE_LIMIT_ENABLED=true
MAX_REQUESTS_PER_MINUTE=120
MAX_HEAVY_REQUESTS_PER_MINUTE=15
MAX_UPLOAD_SIZE_BYTES=10485760

# Causal Engine & Machine Learning Settings
DML_DEFAULT_ESTIMATORS=48
DML_CV_FOLDS=3
DML_SUBFOREST_SIZE=4
RANDOM_SEED=42

# Operational Policy & Optimizer Defaults
DEFAULT_CAMPAIGN_BUDGET=5000.0
DEFAULT_UNIT_MARGIN=45.0
DEFAULT_FREQUENCY_CAP_DAYS=21
DEFAULT_MIN_MARGIN_FLOOR=0.0
DEFAULT_MAX_DISCOUNT_RATE=0.40

# Telemetry & Monitoring Thresholds
DRIFT_PSI_THRESHOLD=0.20
DRIFT_SLIDING_WINDOW_DAYS=7
